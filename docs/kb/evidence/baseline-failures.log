+     </div>
+   );
+ }
+ 
+ function EntityDetailsPanelSkeleton() {
+   return (
+     <aside
+       className="commercial-map-panel commercial-map-details-panel commercial-map-details-skeleton"
+       aria-label="Carregando detalhes da estrutura"

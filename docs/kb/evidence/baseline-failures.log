+     filteredHistoryEntries
+       .reduce((groups, entry) => {
+         const dateKey = localDateKey(entry.created_at);
+         const group = groups.get(dateKey) ?? [];
+         group.push(entry);
+         groups.set(dateKey, group);
+         return groups;
+       }, new Map<string, typeof filteredHistoryEntries>())
+       .entries(),
+   );

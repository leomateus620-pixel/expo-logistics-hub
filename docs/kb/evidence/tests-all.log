+     const depth = Math.max(1, parkingFocusBounds.maxZ - parkingFocusBounds.minZ);
+     return {
+       ...parkingFocusBounds,
+       width,
+       depth,
+       centerX: (parkingFocusBounds.minX + parkingFocusBounds.maxX) / 2,
+       centerZ: (parkingFocusBounds.minZ + parkingFocusBounds.maxZ) / 2,

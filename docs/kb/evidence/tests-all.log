+           depthTest={!publicPolicy}
+           depthWrite={false}
+           vertexColors
+           transparent
+           opacity={Math.min(
+             infrastructureMode ? 0.06 : 0.7,
+             (entries.length > 0 ? layerOpacity[entries[0].entity.layerId] ?? 1 : 1)
+               * (infrastructureMode ? 0.06 : filtersActive ? 0.46 : 0.7),

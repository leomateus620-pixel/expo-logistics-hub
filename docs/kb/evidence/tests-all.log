+ interface LunarCameraControlSnapshot {
+   enabled: boolean;
+   enableDamping: boolean;
+   dampingFactor: number;
+   enablePan: boolean;
+   enableRotate: boolean;
+   enableZoom: boolean;
+   zoomToCursor: boolean;
+   autoRotate: boolean;
+ }

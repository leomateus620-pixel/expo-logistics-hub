{
  "version": 1,
  "sdk_version": "0.26.2",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://btfaumhroqtqzxomqorx.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "fenasoja-log",
      "version": "0.1.0",
      "title": "Fenasoja Log"
    },
    "tools": [
      {
        "name": "list_events",
        "title": "Agenda Fenasoja",
        "description": "Consulta eventos visíveis no período. Descrições privadas e contatos são omitidos.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "from_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Data inicial (YYYY-MM-DD)."
            },
            "to_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Data final (YYYY-MM-DD)."
            },
            "status": {
              "type": "string",
              "maxLength": 60
            },
            "search": {
              "type": "string",
              "maxLength": 120
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_event",
        "title": "Detalhe do evento",
        "description": "Consulta dados operacionais seguros de um evento visível.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "event_id": {
              "type": "string",
              "format": "uuid",
              "description": "ID do evento."
            }
          },
          "required": [
            "event_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_event",
        "title": "Criar evento no cronograma",
        "description": "Cria um novo evento na Agenda Fenasoja para a organização do usuário autenticado.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "description": "Título do evento."
            },
            "start_date": {
              "type": "string",
              "description": "Data de início (YYYY-MM-DD)."
            },
            "end_date": {
              "type": "string",
              "description": "Data de término (YYYY-MM-DD)."
            },
            "start_time": {
              "type": "string",
              "description": "Horário de início (HH:MM)."
            },
            "end_time": {
              "type": "string",
              "description": "Horário de término (HH:MM)."
            },
            "location": {
              "type": "string",
              "description": "Local do evento."
            },
            "description": {
              "type": "string",
              "description": "Descrição/observações."
            },
            "priority": {
              "type": "string",
              "description": "Prioridade do evento."
            }
          },
          "required": [
            "title",
            "start_date"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_transports",
        "title": "Transportes",
        "description": "Consulta estados e horários dos transportes; omite contatos, passageiros individuais e observações privadas.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "maxLength": 60
            },
            "from_datetime": {
              "type": "string",
              "format": "date-time"
            },
            "to_datetime": {
              "type": "string",
              "format": "date-time"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}

+ function createGateArrowGeometry() {
+   const shape = new THREE.Shape();
+   shape.moveTo(-0.09, 0.28);
+   shape.lineTo(0.09, 0.28);
+   shape.lineTo(0.09, -0.04);
+   shape.lineTo(0.24, -0.04);
+   shape.lineTo(0, -0.32);
+   shape.lineTo(-0.24, -0.04);
+   shape.lineTo(-0.09, -0.04);
+   shape.closePath();
+   const geometry = new THREE.ShapeGeometry(shape, 1);

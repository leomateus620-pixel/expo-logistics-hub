+                   field="startDate"
+                   label="Início"
+                   error={errors.startDate}
+                 >
+                   <Input
+                     id="venue-event-start-date"
+                     disabled={isLinkedToCronograma}
+                     type="date"
+                     value={draft.startDate}
+                     onChange={(event) =>
+                       update("startDate", event.target.value)
+                     }
+                     aria-invalid={Boolean(errors.startDate)}
+                   />
+                 </Field>

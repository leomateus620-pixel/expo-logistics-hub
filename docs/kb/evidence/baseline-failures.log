+   outward: THREE.Vector3;
+   side: THREE.Vector3;
+   exteriorPosition: THREE.Vector3;
+   exteriorTarget: THREE.Vector3;
+   chasePosition: THREE.Vector3;
+   chaseTarget: THREE.Vector3;

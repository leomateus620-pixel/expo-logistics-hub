+       entry,
+       publicPolicy ? null : segmentByEntity.get(entityId) ?? null,
+       filtersActive,
+       matchingEntityIds.has(entityId),
+       selected,
+       hovered,
+       infrastructureMode,
+       scratch.color,
+       scratch.blend,
+     );
+     // Realce do carrinho: dourado sólido, mantendo geometria e status originais.

+     view === "agenda" || view === "eventos",
+   );
+ 
+   const buildModulePath = (
+     nextVenue: VenueWorkspaceId,
+     nextView: VenueView,
+     keepEvent = false,
+   ) => {
+     const next = new URLSearchParams(searchParams);
+     next.delete("visao");
+     if (!keepEvent) next.delete("evento");
+     const query = next.toString();
